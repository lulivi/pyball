# One club: <club>.pyball.duckdns.org -> localhost:<port>.
# Usage: import club <club> <port>
(club) {
	@{args[0]} host {args[0]}.pyball.duckdns.org
	handle @{args[0]} {
		reverse_proxy localhost:{args[1]}
	}
}

*.pyball.duckdns.org {
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
	}

	# funnelbot writes enabled/<club> to route a club and deletes it to stop.
	import enabled/*
}
