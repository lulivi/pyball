*.pyball.duckdns.org {
    tls {
        dns duckdns {env.DUCKDNS_TOKEN}
    }

    @tensores host tensores.pyball.duckdns.org
    handle @tensores {
        reverse_proxy localhost:8000
    }

    @cucarachas host cucarachas.pyball.duckdns.org
    handle @cucarachas {
        reverse_proxy localhost:8001
    }
}
